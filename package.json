{
  "name": "fortune-telling",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "main": "node_modules/expo/AppEntry.js",
  "packageManager": "npm@10.9.2",
  "engines": { "node": ">=22.13 <23" },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "prebuild:android": "expo prebuild --clean --platform android",
    "build:android": "npm run prebuild:android && cd android && ./gradlew assembleRelease",
    "verify": "npm run lint && npm test",
    "fdroid": "bash scripts/build-fdroid.sh"
  },
  "jest": { "preset": "jest-expo" },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "astronomy-engine": "2.1.19",
    "expo": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "lunar-javascript": "1.7.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.6",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.0"
  }
}
