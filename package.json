{
  "name": "fortune-telling",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web",
    "build:macos": "npm run build:web && electron-builder --mac",
    "build:android": "npx eas-cli build --platform android --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-serif-sc": "^0.4.2",
    "@expo/metro-runtime": "~3.1.3",
    "astronomy-engine": "^2.1.19",
    "expo": "~50.0.0",
    "expo-font": "~11.10.3",
    "expo-haptics": "~12.8.1",
    "expo-linear-gradient": "~12.7.2",
    "expo-status-bar": "~1.11.1",
    "lucide-react-native": "^0.344.0",
    "lunar-javascript": "^1.6.12",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-svg": "14.1.0",
    "react-native-web": "~0.19.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "wait-on": "^9.0.3"
  },
  "private": true,
  "build": {
    "appId": "com.zengtao.fortunetelling",
    "productName": "Fortune Telling",
    "directories": {
      "output": "release/macos"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        "dmg"
      ]
    }
  }
}
