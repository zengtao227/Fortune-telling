{
  "name": "fortune-telling",
  "version": "1.0.1",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web",
    "build": "npm run build:web",
    "vercel-build": "npm run build:web",
    "build:macos": "npm run build:web && electron-builder --mac",
    "build:android": "npx eas-cli build --platform android --profile preview",
    "lint": "eslint .",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/noto-serif-sc": "^0.4.2",
    "@expo/metro-runtime": "~55.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "astronomy-engine": "^2.1.19",
    "eslint": "^8.0.0",
    "eslint-config-universe": "^15.0.3",
    "expo": "55",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-linear-gradient": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "jest": "^29.3.1",
    "jest-expo": "~55.0.20",
    "lucide-react-native": "^1.28.0",
    "lunar-javascript": "^1.6.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-test-renderer": "19.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "wait-on": "^9.0.3"
  },
  "private": true,
  "build": {
    "appId": "com.zengtao.fortunetelling",
    "productName": "Fortune Telling",
    "directories": {
      "output": "release/macos"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        "dmg"
      ]
    }
  }
}
